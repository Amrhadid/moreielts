# Function deployed on the MoreTOEFL project, so build against that project
# (its publishable key is safe to ship — RLS protects the data):
VITE_SUPABASE_URL=https://nlsuvapjkznatczghvay.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_7ehXXiaMvUlfBQX_zMbDbw_ppOo0lxc

# ---------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set KEY=value`.
# NEVER expose any of these to the client.
# ---------------------------------------------------------------------------
# Injected automatically by Supabase, listed for completeness:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY

# Anthropic, for grade-writing and grade-speaking
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare R2, for the upload-url function
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=moreielts-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Origin allowed to call the Edge Functions (CORS)
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Content generation (local only, never needed at runtime)
# ---------------------------------------------------------------------------
