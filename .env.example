# ---------------------------------------------------------------------------
# Client (Vite) — these are bundled into the browser build.
# Only ever put publishable values here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-anon-key>

# ---------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set KEY=value`.
# NEVER expose any of these to the client.
# ---------------------------------------------------------------------------
# Injected automatically by Supabase, listed for completeness:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY

# Anthropic, for grade-writing and grade-speaking
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare R2, for the upload-url function
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=moreielts-media
R2_PUBLIC_BASE_URL=https://media.example.com

# Origin allowed to call the Edge Functions (CORS)
SITE_URL=http://localhost:3000
