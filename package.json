{
  "name": "moreielts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-db.sh",
    "seed:generate": "esbuild scripts/generate-seed.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/seed.mjs --log-level=error && node node_modules/.cache/seed.mjs",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy ielts-submit-attempt ielts-grade-writing ielts-grade-speaking ielts-upload-url ielts-drill ielts-generate-audio ielts-checkout && supabase functions deploy ielts-grading-worker ielts-stripe-webhook --no-verify-jwt",
    "sql:bundle": "bash scripts/bundle-sql.sh",
    "seed:validate": "esbuild scripts/generate-seed.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/seed.mjs --log-level=error && node node_modules/.cache/seed.mjs --check",
    "sitemap": "esbuild scripts/generate-sitemap.ts --bundle --platform=node --format=esm --alias:~=./src --outfile=node_modules/.cache/sitemap.mjs --log-level=error && node node_modules/.cache/sitemap.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "practice:audio": "esbuild scripts/generate-practice-audio.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/practice-audio.mjs --log-level=error && node node_modules/.cache/practice-audio.mjs",
    "functions:build": "bash scripts/build-functions.sh",
    "mock:audio": "esbuild scripts/generate-mock-audio.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/mock-audio.mjs --log-level=error && node node_modules/.cache/mock-audio.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.10"
  }
}
